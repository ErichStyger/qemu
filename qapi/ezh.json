##
# @EzhGetRegisterReturn:
#
# Return type for ezh-get-register.
#
# @value: Register value.
##
{ 'struct': 
    'EzhGetRegisterReturn', 'data': 
    { 
        'value': 'int' 
    } 
}

##
# @ezh-get-register:
#
# Read an EZH CPU register.
#
# @reg: Register index.
#
# Returns: Register value.
##
{ 'command': 
    'ezh-get-register', 'data': 
    { 
        'reg': 'int' 
    }, 
    'returns': 'EzhGetRegisterReturn' 
}

##
# @ezh-set-register:
#
# Write an EZH CPU register.
#
# @reg: Register index.
#
# @value: Value to write.
##
{ 'command': 
    'ezh-set-register', 'data': 
    { 
        'reg': 'int', 'value': 'int' 
    } 
}